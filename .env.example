# ==============================================================================
# ApexSaaS AI - Environment Configuration Variables
# ==============================================================================

# NEXT.JS APP CONFIG
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="ApexSaaS AI"

# SUPABASE AUTHENTICATION & DATABASE
# Get these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# STRIPE BILLING & PAYMENTS
# Get these from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."

# STRIPE PRODUCT / PRICE IDS (Create recurring or one-time prices in Stripe Dashboard)
NEXT_PUBLIC_STRIPE_STARTER_PRICE_ID="price_starter_monthly"
NEXT_PUBLIC_STRIPE_PRO_PRICE_ID="price_pro_monthly"
NEXT_PUBLIC_STRIPE_LIFETIME_PRICE_ID="price_lifetime_deal"

# AI LLM PROVIDER API KEYS
# Google Gemini (https://aistudio.google.com/)
GEMINI_API_KEY="AIzaSy..."

# OpenAI API (https://platform.openai.com/api-keys)
OPENAI_API_KEY="sk-proj-..."

# DEFAULT AI MODEL (options: "gemini-2.0-flash", "gemini-1.5-pro", "gpt-4o", "gpt-4o-mini")
DEFAULT_AI_MODEL="gemini-2.0-flash"
